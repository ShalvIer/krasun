{
  "name": "krasun",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,blue \"npm run dev -w @krasun/api\" \"npm run dev -w @krasun/web\"",
    "dev:api": "npm run dev -w @krasun/api",
    "dev:web": "npm run dev -w @krasun/web",
    "build": "npm run build -w @krasun/api && npm run build -w @krasun/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate -w @krasun/api",
    "db:migrate": "npm run db:migrate -w @krasun/api",
    "db:deploy": "npm run db:deploy -w @krasun/api",
    "db:seed": "npm run db:seed -w @krasun/api",
    "db:studio": "npm run db:studio -w @krasun/api"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "concurrently": "^9.2.1"
  }
}
