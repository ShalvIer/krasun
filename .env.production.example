DOMAIN=krasun.example.com

POSTGRES_DB=krasun
POSTGRES_USER=krasun
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://krasun:replace-with-the-same-password@postgres:5432/krasun
# To use managed PostgreSQL instead, set its TLS connection string here.
# DATABASE_URL=postgresql://user:password@host:5432/krasun?sslmode=require

GOOGLE_CLIENT_ID=replace-with-google-client-id
MAPBOX_SERVER_TOKEN=replace-with-secret-mapbox-token
VITE_MAPBOX_TOKEN=replace-with-public-mapbox-token

ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
REFRESH_TOKEN_SECRET=replace-with-a-different-32-character-secret
COOKIE_SECRET=replace-with-a-third-different-32-character-secret

ACCESS_TOKEN_TTL_MINUTES=15
SESSION_IDLE_HOURS=24
SESSION_ABSOLUTE_DAYS=7
ENABLE_DEV_AUTH=false
